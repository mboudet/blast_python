# --- App ---
APP_TITLE=Blast server
BASE_URL_PATH=
# Max size (MiB) of each uploaded file / the pasted sequence.
UPLOAD_LIMIT=100
# Max job submissions per client IP per minute (0 disables). Behind a reverse
# proxy also run uvicorn with --proxy-headers --forwarded-allow-ips=<proxy ip>
# and set a body-size limit (client_max_body_size) on the proxy.
SUBMIT_RATE_LIMIT=10
HISTORY_LENGTH=8

# --- Template / static overrides ---
# Optional directories mounted into the container (e.g. via a docker volume)
# to override the default layout/templates and to serve custom static assets
# (css, images). TEMPLATES_OVERRIDE_DIR is searched before the built-in
# templates, so you can drop a custom layout.html there. STATIC_OVERRIDE_DIR is
# served at /static/custom/. CUSTOM_CSS is a full URL, an absolute path, or a
# filename relative to STATIC_OVERRIDE_DIR (e.g. "custom.css") that is linked
# from the layout's <head>. Leave empty to use the built-in rendering.
TEMPLATES_OVERRIDE_DIR=
STATIC_OVERRIDE_DIR=
CUSTOM_CSS=

# --- Database ---
# Prefer DATABASE_URL (SQLAlchemy). If left empty the legacy DB_* vars are used.
#DATABASE_URL=sqlite:////workspace/blast_new/blast.db
DB_DRIVER=sqlite   # sqlite, pgsql, mysql
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=

# --- Scheduler: "slurm" or "drmaa" ---
JOBS_METHOD=slurm
JOBS_WORK_DIR=/tmp/
JOBS_SCHED_NAME=blast

# --- Run-as user (used by the container entrypoint) ---
# Create and run the webserver as a user with the given uid/gid so that jobs
# run under the same user as on the compute nodes. Leave empty for defaults.
UID=
GID=
APP_USER=blast
APP_GROUP=blast

# --- Slurm REST API ---
SLURM_REST_URL=http://slurmctld:6820
SLURM_API_VERSION=v0.0.40
# Set to false to skip TLS certificate verification.
SLURM_VERIFY_TLS=true
SLURM_JWT=
SLURM_JWT_FILE=
# Submit jobs as this user via X-SLURM-USER-NAME (impersonation). Set to the
# APP_USER above so REST jobs run as the same user as DRMAA jobs. The JWT token
# must belong to a user with SlurmUser/admin rights. Leave empty to not send it.
SLURM_USER=blast
SLURM_PARTITION=
SLURM_QOS=
SLURM_ACCOUNT=
SLURM_NATIVE=

# --- Blast options ---
CDD_DELTA_PATH=
PRE_CMD=
BANKS_CONFIG=/workspace/blast_new/config/banks.yml
LINKS_CONFIG=/workspace/blast_new/config/links.yml

# --- Mail ---
ADMIN_EMAIL=admin@blast-server
ADMIN_NAME=Blast admin
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=false
